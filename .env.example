# Anthropic Claude API Key
# 取得方式:https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# FastAPI 設定
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ChromaDB 資料儲存路徑
CHROMA_PERSIST_DIR=./chromadb_data

# SQLite DB 路徑(Phase 4 HITL 用)
DATABASE_URL=sqlite:///./travel_agent.db
